# =========================================================================
# Face Surveillance — Environment Variables
# =========================================================================
# Copy this file to .env and fill in your values.
# The .env file should be placed in the project root (face-surveillance/).

# -- Mode --
ENV=development                    # "development" or "production"

# -- Supabase --
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-supabase-api-key
SUPABASE_STORAGE_BUCKET=snapshots

# -- DeepFace --
DEEPFACE_MODEL=VGG-Face            # Options: VGG-Face, Facenet, OpenFace, DeepID, ArcFace

# -- Detection --
DETECTION_INTERVAL_SECONDS=2.0     # Seconds between each detection cycle
FRAME_BROADCAST_FPS=5              # Max frames per second sent via WebSocket

# -- Model Pipeline --
FACE_DETECTOR=yolov8               # "yolov8" or "deepface_legacy"
FACE_TRACKER=bytetrack             # "bytetrack", "botsort", or "none"
YOLO_CONFIDENCE=0.5                # Detection confidence threshold (0.0–1.0)
YOLO_MODEL_PATH=yolov8n-face.pt    # Path to YOLO model weights
INSIGHT_MODEL=buffalo_l            # InsightFace model pack
TRACK_REANALYZE_TTL=300            # Seconds before re-analyzing a tracked face

# -- GPU --
USE_GPU=auto                       # "auto" (detect), "cuda", or "cpu"

# -- MediaMTX (optional RTSP proxy) --
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
USE_MEDIAMTX=true                  # Set to "false" to bypass MediaMTX

# -- Snapshots --
SNAPSHOT_STORAGE=local             # "local" or "supabase"
SNAPSHOT_LOCAL_DIR=snapshots       # Directory for local snapshot storage

# -- CORS --
CORS_ORIGINS=http://localhost:5173 # Comma-separated list of allowed origins

# -- Security --
SECRET_KEY=change-me-to-a-random-string

# -- WebSocket --
STATS_BROADCAST_INTERVAL=5        # Seconds between stats pushes
