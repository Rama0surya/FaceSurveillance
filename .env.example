# -- Mode --
ENV=development

SERVER_IP=[local IP]

# -- Database (Local MySQL) --
DB_HOST=database # Changed from localhost so containers can talk to each other
DB_PORT=3306
DB_USER=nvruser
DB_PASSWORD=user123
DB_NAME=face_surveillance
DATABASE_URL=mysql+pymysql://nvruser:user123@database:3306/face_surveillance

# -- AI Search (CLIP) --
CLIP_ENABLED=true
CLIP_MODEL_PRESET=clip-light

# -- Supabase --
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-supabase-api-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=snapshots

# -- DeepFace --
DEEPFACE_MODEL=VGG-Face

# -- Detection --
DETECTION_INTERVAL_SECONDS=2.0
FRAME_BROADCAST_FPS=5

# -- Model Pipeline --
FACE_DETECTOR=yolov8
FACE_TRACKER=bytetrack
YOLO_CONFIDENCE=0.5
YOLO_MODEL_PATH=yolov8n-face.pt
INSIGHT_MODEL=buffalo_l
TRACK_REANALYZE_TTL=300

# -- GPU --
USE_GPU=false

# -- MediaMTX --
MEDIAMTX_API_URL=http://192.168.0.152:9997
MEDIAMTX_RTSP_URL=rtsp://192.168.0.152:8554
VITE_API_URL=http://192.168.0.152:8000
USE_MEDIAMTX=true

# -- Snapshots --
SNAPSHOT_STORAGE=local
SNAPSHOT_LOCAL_DIR=snapshots
SNAPSHOT_BASE_URL=http://192.168.0.152:8000

# -- CORS --
CORS_ORIGINS=http://192.168.0.152:5173,http://localhost:5173

# -- Security --
SECRET_KEY=change-me-to-a-random-string

# -- WebSocket --
STATS_BROADCAST_INTERVAL=5
